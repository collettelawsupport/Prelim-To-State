# Public URL of this Netlify site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://registration.texasourlittlemiss.net

# Keep false until the complete sandbox test has passed and production
# QuickBooks credentials, product SKUs, webhooks, and Big Form settings are ready.
REGISTRATION_ENABLED=false

# Optional server-only code for an approved no-payment-today registration.
# A valid code applies a fixed $100 credit to the final QuickBooks invoice.
REGISTRATION_WAIVER_CODE=

# Intuit Developer application (QuickBooks Online Accounting scope).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://registration.texasourlittlemiss.net/api/quickbooks/callback
QBO_ENVIRONMENT=production
QBO_SETUP_KEY=replace-with-a-long-random-admin-key
QBO_WEBHOOK_VERIFIER_TOKEN=

# Stable QuickBooks Products/Services SKUs used on invoice lines. The app looks
# up the corresponding company-specific item IDs after QuickBooks is connected.
QBO_REGISTRATION_ITEM_SKU=OLM-STATE-REG
QBO_OPTIONAL_ITEM_SKU=OLM-OPTIONAL

# Paid or approved-waiver contestants receive this form URL. The registration ID and one-time
# workflow token are appended as query parameters.
BIG_FORM_URL=https://your-big-form.netlify.app
BIG_FORM_CALLBACK_SECRET=replace-with-a-different-long-random-key

# Gmail is preferred when both Gmail values are configured. Use a 16-character
# Google App Password, never the account's normal password. Resend is the
# alternative when both RESEND_API_KEY and EMAIL_FROM are configured. The
# personalized Big Form link always remains available on the confirmation page.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=Texas Our Little Miss <your-sending-address@example.com>
